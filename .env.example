# ---------------------------------------------------------------------------
# Luma.Green — environment template
#
# Copy to `.env.local` and fill in what you need. EVERY var here is optional:
# the app builds, tests and runs with an empty file. Some features need an
# explicit enable flag as well as keys. Follow their operation guides.
#
# Never commit `.env.local`. Production values live in the Vercel dashboard,
# staging values in the Vercel preview scope — see docs/operations/environments.md.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional HTML ownership tokens, content value only; no tracking script.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# --- Convex (database + server functions) ----------------------------------
# `npx convex dev` writes these for you on first run. The site URL is where
# HTTP actions (and sign-in) live: the same host with .convex.site.
NEXT_PUBLIC_CONVEX_URL=""
NEXT_PUBLIC_CONVEX_SITE_URL=""
CONVEX_DEPLOYMENT=""
# CI/CD only — from the Convex dashboard, Production > Deploy key.
CONVEX_DEPLOY_KEY=""

# --- Auth (Better Auth) ----------------------------------------------------
# Better Auth runs inside Convex, so its settings live on the Convex
# deployment, not here (docs/operations/environments.md):
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set ADMIN_EMAIL you@example.com
#   ADMIN_SETUP_TOKEN: set a separate random secret of at least 32 characters
#   on Convex. Enter it only on /admin/setup; remove it after setup.
#   Never use a NEXT_PUBLIC variable for this token.
#   npx convex env set AUTH_DEV_MODE true   # dev only: codes go to the log
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Optional telemetry (docs/operations/observability.md) -----------------
# Set true only in the intended deployment; rebuild after any public change.
# Blank/false disables PostHog, Google Analytics and Sentry, even with keys.
NEXT_PUBLIC_TELEMETRY_ENABLED=""

# --- Public-page analytics (PostHog and/or Google Analytics 4) --------------
# Also needs the visitor's explicit choice. Private workflows are excluded.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Format: G-XXXXXXXXXX. Disable Enhanced Measurement entirely in GA first.
# Do not install a second GA/GTM tag: the app sends manual page views.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Error tracking (Sentry) -----------------------------------------------
# Requires the enable flag above and a DSN. Independent of analytics choice.
# Errors only; traces, replay, logs and identifying event context are disabled.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# CI only — needed to upload source maps.
SENTRY_AUTH_TOKEN=""

# --- OTP (MSG91) -----------------------------------------------------------
# Set on the Convex deployment, once the provider templates are approved.
# .env.local does not configure deployed Convex functions.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# --- Status SMS (MSG91 Flow; Convex deployment only) -----------------------
# JSON: {"booking_confirmed":{"en":"approved-template-id"}, ...}
# Full event list and VAR1 contract: docs/operations/sms-notifications.md
MSG91_NOTIFICATION_TEMPLATES=""
SMS_NOTIFICATION_BASE_URL=""
# No language fallback unless explicitly enabled.
MSG91_NOTIFICATION_ENGLISH_FALLBACK=""

# --- Optional device push (Convex deployment only) -------------------------
# In-app inbox works without these. Keep private keys/access tokens in Convex.
# See docs/operations/push-notifications.md. Never use NEXT_PUBLIC for secrets.
WEB_PUSH_ENABLED=""
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""
EXPO_PUSH_ENABLED=""
EXPO_PUSH_ACCESS_TOKEN=""

# --- Optional photo estimates (server-side Convex settings) ----------------
# Blank keeps the existing OpenRouter adapter; self-hosted NEVER falls back to paid calls.
PHOTO_ESTIMATE_PROVIDER=""
# Self-hosted: full public HTTPS OpenAI-compatible /v1/chat/completions endpoint.
# Put Ollama behind an authenticated gateway; its local API does not enforce API keys.
# Convex cloud cannot reach localhost or a private router. No browser credentials.
PHOTO_ESTIMATE_ENDPOINT=""
PHOTO_ESTIMATE_API_KEY=""
# Operator must verify the selected vision model license and hardware latency.
PHOTO_ESTIMATE_MODEL=""
# Set a hard spending limit on the key before using it anywhere but locally.
OPENROUTER_API_KEY=""
# Set on Convex. Choose a vision model with strict structured output support.
OPENROUTER_MODEL=""
# Rolling 24-hour global cap; 1–1000, default 100. Failed calls consume quota.
PHOTO_ESTIMATE_DAILY_LIMIT="100"

# Optional admin password recovery (set these in Convex, not browser bundles).
# Configure a verified Resend sender before enabling. SITE_URL must use HTTPS.
# RESEND_API_KEY=
# ADMIN_RESET_FROM_EMAIL=security@example.com

# --- Optional industry news (Convex deployment only) -----------------------
# NewsAPI production use needs a suitable provider plan and content rights.
# No requests without explicit enablement. No automatic retry or paid fallback.
INDUSTRY_NEWS_ENABLED=""
INDUSTRY_NEWS_API_KEY=""
# Hard global 24-hour window provider cap; failed requests consume quota too.
INDUSTRY_NEWS_DAILY_LIMIT="100"

# --- Public area data (Convex deployment only) -----------------------------
# Off by default. Read docs/operations/public-data.md before enabling.
PUBLIC_DATA_ENABLED="false"
MET_NORWAY_USER_AGENT=""
DATA_GOV_IN_API_KEY=""
DATA_GOV_IN_AIR_RESOURCE_ID=""
