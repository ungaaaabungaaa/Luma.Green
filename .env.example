# ---------------------------------------------------------------------------
# Luma.Green — environment template
#
# Copy to `.env.local` and fill in what you need. EVERY var here is optional:
# the app builds, tests and runs with an empty file. A feature turns itself on
# when its keys appear.
#
# Never commit `.env.local`. Production values live in the Vercel dashboard,
# staging values in the Vercel preview scope — see docs/operations/environments.md.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Convex (database + server functions) ----------------------------------
# `npx convex dev` writes both of these for you on first run.
NEXT_PUBLIC_CONVEX_URL=""
CONVEX_DEPLOYMENT=""
# CI/CD only — from the Convex dashboard, Production > Deploy key.
CONVEX_DEPLOY_KEY=""

# --- Auth (Better Auth) ----------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Product analytics (PostHog) -------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- Error tracking (Sentry) -----------------------------------------------
# Sentry only wraps the build when NEXT_PUBLIC_SENTRY_DSN is set.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# CI only — needed to upload source maps.
SENTRY_AUTH_TOKEN=""

# --- Maps (Mapbox) ---------------------------------------------------------
# Restrict this token by URL in the Mapbox dashboard before shipping.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Transactional email (Resend) ------------------------------------------
RESEND_API_KEY=""

# --- OTP (MSG91) -----------------------------------------------------------
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# --- Payments (Razorpay) ---------------------------------------------------
# Use test keys locally. Live keys belong only in the production environment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Object storage (Cloudflare R2) ----------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="luma-green-dev"

# --- AI routing (OpenRouter) -----------------------------------------------
# Set a hard spending limit on the key before using it anywhere but locally.
OPENROUTER_API_KEY=""
